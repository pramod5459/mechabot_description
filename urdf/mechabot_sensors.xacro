<?xml version="1.0" ?>
<robot name="bot_name" xmlns:xacro="http://www.ros.org/wiki/xacro">

    

    <link name="lidar_link">
        <visual>
            <origin xyz="-0.028 0.0 -0.132" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mechabot_description/meshes/mechabot_lidar.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.5 0.5 0.0 1.0"/>
            </material>
        </visual>
        collision>
            <origin xyz="-0.028 0.0 -0.132" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mechabot_description/meshes/mechabot_lidar.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.5 0.5 0.0 1.0"/>
            </material>
    </link>

    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.028 0.0 0.1195" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="lidar_link"/>
    </joint>


     <link name="camera_link">
        <visual>
            <origin xyz="-0.118 0.0 -0.092" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mechabot_description/meshes/mechabot_camera.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.0 0.5 0.0 1.0"/>
            </material>
        </visual>
        collision>
            <origin xyz="-0.118 0.0 -0.092" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mechabot_description/meshes/mechabot_camera.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.0 0.5 0.0 1.0"/>
            </material>
    </link>

    <joint name="camera_joint" type="fixed">
        <origin xyz="0.118 0.0 0.08" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>


    <link name="imu_link">
        <visual>
            <origin xyz="0.0 0.0 -0.035" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mechabot_description/meshes/mechabot_imu.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.0 0.5 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 -0.035" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://mechabot_description/meshes/mechabot_imu.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="yellow">
                <color rgba="0.0 0.5 0.0 1.0"/>
            </material>
        </collision>
    </link>

    <joint name="imu_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0225" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu_link"/>
    </joint>

</robot>   